{
  "name": "lock-back",
  "version": "1.0.0",
  "description": "Lock Back - a two-team real-time number game",
  "main": "main.js",
  "bin": "main.js",
  "scripts": {
    "start": "node launcher.js",
    "build": "pkg . --no-bytecode --public-packages \"*\" --public --out-path dist",
    "server": "node server.js"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.4"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "data/**/*",
      "node_modules/socket.io/client-dist/**/*"
    ],
    "targets": [
      "node22-macos-arm64",
      "node22-macos-x64",
      "node22-win-x64"
    ]
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.0.0",
    "socket.io-client": "^4.8.4"
  }
}
